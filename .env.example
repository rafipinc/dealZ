# Copy to .env.local. SETUP.md section 2 has the local Supabase values.
# The app uses the transaction pooler; migrations use the direct connection.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API keys are not kept in this file locally. They live in the macOS Keychain
# and are injected by `scripts/keys.sh run` (SETUP.md, "API keys"). The names
# are listed here so the set is documented; leave the values empty.
# Google Gemini, for the llm_extract source (ADR-0013, proposed): https://aistudio.google.com/
GEMINI_API_KEY=
# SerpApi, for the Google Shopping search source (ADR-0012): https://serpapi.com/
SERPAPI_API_KEY=
# OpenAI, for the model-assisted price history search (ADR-0020, proposed): https://platform.openai.com/
OPENAI_API_KEY=

# Google Shopping discovery through SerpApi: successful searches allowed per Sydney day (ADR-0017). 0 disables it.
SERPAPI_DAILY_CAP=20
# Model-assisted price history through OpenAI: requests allowed per Sydney day (ADR-0020, proposed). 0 disables it.
OPENAI_DAILY_CAP=10
