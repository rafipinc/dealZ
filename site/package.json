{
  "name": "dealz-build-log",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.ts",
    "check": "node scripts/generate.ts --check",
    "predev": "npm run generate",
    "dev": "next dev -p ${PORT:-3100}",
    "prebuild": "npm run generate",
    "build": "next build",
    "typecheck": "npm run generate && next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "marked": "^18.0.14",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
